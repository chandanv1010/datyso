<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 0. Chặn truy cập thư mục backup trả về 403 Forbidden
    RewriteCond %{THE_REQUEST} \s/+(?:public/)?backup(?:/|\s|\?) [NC,OR]
    RewriteCond %{REQUEST_URI} ^/(?:public/)?backup(/.*)?$ [NC]
    RewriteRule ^ - [F,L]

    # 1. Nếu request trực tiếp vào /public/ hoặc /public, 301 về trang chủ /
    RewriteCond %{THE_REQUEST} \s/+public/?[\s?] [NC]
    RewriteRule ^ / [L,R=301]

    # 2. Nếu request trực tiếp có /public/... kèm dấu "/" cuối, 301 một bước về URL chuẩn (không /public/ và không "/")
    RewriteCond %{THE_REQUEST} \s/+public/(.+?)/+[\s?] [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /%1 [L,R=301]

    # 3. Nếu request trực tiếp có tiền tố /public/, 301 về URL chuẩn không có /public/
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /%1 [L,R=301]

    # 4. 301 một bước: Bỏ dấu "/" ở cuối URL (không qua /public/)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/+$
    RewriteCond %{REQUEST_URI} ^(?:/public)?/(.+?)/+$
    RewriteRule ^ /%1 [L,R=301]

    # 5. Rewrite ngầm nội bộ toàn bộ request vào thư mục public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
