<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 0. Chặn truy cập thư mục backup trả về 403 Forbidden
    RewriteCond %{THE_REQUEST} \s/+(?:public/)?backup(?:/|\s|\?) [NC,OR]
    RewriteCond %{REQUEST_URI} ^/(?:public/)?backup(/.*)?$ [NC]
    RewriteRule ^ - [F,L]

    # 0b. Chặn vĩnh viễn tệp xác minh Search Console của hacker (luôn trả 404 trên cả local và hosting)
    RewriteRule ^(?:public/)?googlef0602e43eee72fd4\.html/?$ - [NC,R=404,L]

    # 1. Chuyển hướng 301: www -> https:// (giữ nguyên tên miền non-www và đường dẫn)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # 2. Nếu request trực tiếp vào /public/ hoặc /public, 301 về trang chủ /
    RewriteCond %{THE_REQUEST} \s/+public/?[\s?] [NC]
    RewriteRule ^ / [L,R=301]

    # 3. Nếu request trực tiếp có /public/... kèm dấu "/" cuối, 301 một bước về URL chuẩn (không /public/ và không "/")
    RewriteCond %{THE_REQUEST} \s/+public/(.+?)/+[\s?] [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /%1 [L,R=301]

    # 4. Nếu request trực tiếp có tiền tố /public/, 301 về URL chuẩn không có /public/
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /%1 [L,R=301]

    # 5. 301 một bước: Bỏ dấu "/" ở cuối URL (không qua /public/)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/+$
    RewriteCond %{REQUEST_URI} ^(?:/public)?/(.+?)/+$
    RewriteRule ^ /%1 [L,R=301]

    # 6. Rewrite ngầm nội bộ toàn bộ request vào thư mục public/ (an toàn cho cả local subfolder và hosting)
    RewriteRule ^(?!public(?:/|$))(.*)$ public/$1 [L]
</IfModule>
